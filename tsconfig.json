{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/themes": ["src/themes/"],
      "@/components": ["src/components/"]
    },

    /* Library mode */
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "types": [
      "node",
      "vite/client",
      "@storybook/vue3"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/themes/index.ts",
    "src/types/global.d.ts",
    "src/stories/**/*",
    ".storybook/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}